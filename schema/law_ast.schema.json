{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mx-md Law AST",
  "description": "Canonical structured representation of a Mexican federal law. Generated from PDF, used to render Markdown and power APIs.",
  "type": "object",
  "required": ["schema_version", "id", "name", "source", "structure"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version for forward compatibility.",
      "examples": ["1.0.0"]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]+$",
      "description": "Stable unique identifier (the md_slug). Acronym + underscore + snake_case name slug.",
      "examples": [
        "CPEUM_constitucion_politica_de_los_estados_unidos_mexicanos",
        "LISR_ley_del_impuesto_sobre_la_renta",
        "CCom_codigo_de_comercio"
      ]
    },
    "abbreviation": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "description": "Official abbreviation.",
      "examples": ["CPEUM", "CFF", "LISR", "CCom"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full official name.",
      "examples": ["CONSTITUCIÓN Política de los Estados Unidos Mexicanos"]
    },
    "catalog_number": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Sequential number from the Cámara de Diputados index.",
      "examples": ["001", "315"]
    },
    "source": {
      "type": "object",
      "required": ["pdf_url", "captured_at"],
      "properties": {
        "pdf_url": {
          "type": "string",
          "format": "uri",
          "description": "Official PDF URL from diputados.gob.mx.",
          "examples": ["https://www.diputados.gob.mx/LeyesBiblio/pdf/CPEUM.pdf"]
        },
        "pdf_filename_origen": {
          "type": "string",
          "description": "Original filename on the server.",
          "examples": ["CPEUM.pdf"]
        },
        "dof_publication": {
          "type": "string",
          "description": "Original DOF publication date.",
          "examples": ["DOF 05/02/1917"]
        },
        "last_reform": {
          "type": "string",
          "description": "Last reform as published.",
          "examples": ["DOF 03/03/2026"]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the PDF was downloaded and processed.",
          "examples": ["2026-03-21T18:30:00Z"]
        }
      }
    },
    "preamble": {
      "type": "array",
      "minItems": 1,
      "description": "Content before the first structural division (introductory notes, publication history, fracciones, etc.).",
      "items": { "$ref": "#/$defs/content_element" }
    },
    "structure": {
      "type": "array",
      "description": "Top-level structural divisions (Títulos, Libros, or directly Capítulos/Artículos for simpler laws). Puede estar vacío en leyes que solo tienen preámbulo + transitorios.",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "description": "A structural node in the law hierarchy.",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "libro",
            "titulo",
            "capitulo",
            "seccion",
            "articulo",
            "transitorios",
            "transitorio_articulo"
          ],
          "description": "Structural type."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*$",
          "description": "Stable path-based ID within the law. Segments are joined by '.' and use lowercase ASCII, dígitos, guiones o underscores dentro de cada segmento.",
          "examples": [
            "titulo-1",
            "titulo-primero.capitulo-i",
            "titulo-1.capitulo-2.articulo-15",
            "transitorios",
            "transitorios.transitorio_articulo-primero"
          ]
        },
        "heading": {
          "type": "string",
          "description": "The heading text.",
          "examples": ["TÍTULO I", "Capítulo II", "Artículo 15", "ARTÍCULO PRIMERO"]
        },
        "descriptor": {
          "type": ["string", "null"],
          "description": "Optional descriptive name.",
          "examples": ["DISPOSICIONES GENERALES", "De los Derechos Humanos y sus Garantías"]
        },
        "ordinal": {
          "type": ["string", "null"],
          "description": "The enumeration value.",
          "examples": ["I", "15", "15-A", "Bis", "PRIMERO"]
        },
        "content": {
          "type": "array",
          "description": "Body content of this node: paragraphs, fracciones, incisos, tables, reform notes.",
          "items": { "$ref": "#/$defs/content_element" }
        },
        "children": {
          "type": "array",
          "description": "Child structural nodes (e.g. capítulos inside título, artículos inside capítulo).",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "content_element": {
      "oneOf": [
        { "$ref": "#/$defs/text_block" },
        { "$ref": "#/$defs/fraccion" },
        { "$ref": "#/$defs/inciso" },
        { "$ref": "#/$defs/apartado" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/reform_note" }
      ]
    },
    "text_block": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Plain text content of the paragraph."
        }
      }
    },
    "fraccion": {
      "type": "object",
      "required": ["type", "ordinal", "text"],
      "properties": {
        "type": { "const": "fraccion" },
        "ordinal": {
          "type": "string",
          "pattern": "^[IVXLCDM]+(?:[- ][A-Za-z]+)?$",
          "description": "Roman numeral, opcionalmente seguido de '-A', '-B', ' bis', etc.",
          "examples": ["I", "II", "XVI", "XXIX", "XXIX-A"]
        },
        "text": {
          "type": "string",
          "description": "Text of the fracción."
        },
        "incisos": {
          "type": "array",
          "items": { "$ref": "#/$defs/inciso" }
        },
        "reform_notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reform_note" }
        }
      }
    },
    "inciso": {
      "type": "object",
      "required": ["type", "ordinal", "text"],
      "properties": {
        "type": { "const": "inciso" },
        "ordinal": {
          "type": "string",
          "pattern": "^[a-z]$",
          "description": "Lowercase ASCII letter.",
          "examples": ["a", "b", "c"]
        },
        "text": {
          "type": "string",
          "description": "Text of the inciso."
        },
        "numerals": {
          "type": "array",
          "description": "Sub-numerals (1., 2., 3.) nested under inciso.",
          "items": {
            "type": "object",
            "required": ["type", "ordinal", "text"],
            "properties": {
              "type": { "const": "numeral" },
              "ordinal": {
                "type": "string",
                "pattern": "^\\d+$",
                "description": "Decimal numeral.",
                "examples": ["1", "2", "10"]
              },
              "text": { "type": "string" }
            }
          }
        },
        "reform_notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reform_note" }
        }
      }
    },
    "apartado": {
      "type": "object",
      "required": ["type", "ordinal"],
      "properties": {
        "type": { "const": "apartado" },
        "ordinal": {
          "type": "string",
          "pattern": "^[A-Z]$",
          "description": "Uppercase ASCII letter.",
          "examples": ["A", "B", "C", "D"]
        },
        "text": {
          "type": "string",
          "description": "Opening text of the apartado."
        },
        "fracciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/fraccion" }
        },
        "reform_notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reform_note" }
        }
      }
    },
    "table": {
      "type": "object",
      "required": ["type", "headers", "rows"],
      "properties": {
        "type": { "const": "table" },
        "title": {
          "type": ["string", "null"],
          "description": "Optional table title.",
          "examples": ["TARIFA MENSUAL"]
        },
        "headers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Column header names."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": "Data rows, each an array of cell values."
        },
        "source_method": {
          "type": "string",
          "enum": ["text", "ocr"],
          "description": "'text' if extracted natively from PDF, 'ocr' if via Tesseract."
        },
        "source_page": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "PDF page number where the table was found (1-indexed)."
        }
      }
    },
    "reform_note": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "reform_note" },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Raw reform annotation.",
          "examples": ["Párrafo reformado DOF 10-06-2011"]
        },
        "action": {
          "type": ["string", "null"],
          "enum": ["reformado", "adicionado", "derogado", "recorrido", "abrogado", "fe_de_erratas", null],
          "description": "Parsed reform action, if detectable."
        },
        "dof_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{2}[-/]\\d{2}[-/]\\d{4}$",
          "description": "Parsed DOF date from the note (dd-mm-yyyy o dd/mm/yyyy).",
          "examples": ["10-06-2011", "30/09/2024"]
        }
      }
    }
  }
}
